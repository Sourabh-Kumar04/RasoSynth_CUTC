# Google Gemini
GOOGLE_API_KEY=

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Hugging Face
HF_TOKEN=

# XAI (Grok)
XAI_API_KEY=

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Infrastructure
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql+asyncpg://user:pass@localhost:5432/dataset_engine
QDRANT_URL=http://localhost:6333

# API Keys
SERPAPI_KEY=
GOOGLE_SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=

# Feature Flags
ENABLE_CELERY=true
ENABLE_RAY=false
ENABLE_HITL=false

# Resource Limits
MAX_CONCURRENT_JOBS=5
TOKEN_BUDGET_USD=100.0

# Rate Limits (requests per minute)
RATE_LIMIT_GEMINI=60
RATE_LIMIT_NIM=30
RATE_LIMIT_ANTHROPIC=50
RATE_LIMIT_OPENAI=60

# Cache TTL (seconds)
CACHE_TTL=3600