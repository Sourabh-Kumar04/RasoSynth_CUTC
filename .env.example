# Google Gemini
GOOGLE_API_KEY=

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Hugging Face
HF_TOKEN=

# Optional AIKosh authenticated dataset catalogue discovery
AIKOSH_API_KEY=

# XAI (Grok)
XAI_API_KEY=

# Fireworks AI (OpenAI-compatible)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Featherless AI (OpenAI-compatible)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Infrastructure
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=dataset_user
POSTGRES_PASSWORD=
POSTGRES_DB=dataset_engine
# For local app runs, point this at your PostgreSQL instance. Docker Compose
# builds the in-network URL from POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB.
# Generate a secure password: e.g. openssl rand -base64 24
POSTGRES_URL=

# ── Supabase (recommended for HuggingFace Spaces / serverless) ────────────────
# Use the SESSION-MODE POOLER (port 6543) for HF Spaces / serverless environments.
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Then change "postgresql://" to "postgresql+asyncpg://"
#
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Example format:
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR_PROJECT_REF]:[PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres
#
# On HuggingFace Spaces: add DATABASE_URL as a Space Secret (Settings → Variables and secrets)
# The backend reads either POSTGRES_URL or DATABASE_URL (both are aliases).
# DATABASE_URL=

QDRANT_URL=http://localhost:6333

# API Keys
SERPAPI_KEY=
GOOGLE_SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=

# Feature Flags
ENABLE_CELERY=true
ENABLE_RAY=false
ENABLE_HITL=false

# Human-in-the-Loop (HITL) dataset review
# human_review_mode: "blocking" (pause pipeline until reviewer resumes) | "async" (submit + continue)
HITL_MODE=blocking
# Max seconds to wait for reviewer before auto-approving (0 = unlimited)
HITL_TIMEOUT_SECONDS=0

# Fine-tuning
# Maximum number of concurrent fine-tuning jobs (GPU is a shared resource)
FINETUNE_MAX_CONCURRENT=1
# Maximum samples to load from a single JSONL dataset (prevents OOM)
FINETUNE_MAX_SAMPLES=500000
# Log ring buffer size per job
FINETUNE_LOG_BUFFER=500

# Resource Limits
MAX_CONCURRENT_JOBS=5
MAX_JOB_QUEUE_SIZE=50
TOKEN_BUDGET_USD=100.0

# Rate Limits (requests per minute)
RATE_LIMIT_GEMINI=60
RATE_LIMIT_NIM=30
RATE_LIMIT_ANTHROPIC=50
RATE_LIMIT_OPENAI=60

# Cache TTL (seconds)
CACHE_TTL=3600

# ── Cloud GPU & Serverless Fine-Tuning ───────────────────────────────────────
# Modal Labs serverless GPU fabric (A10G / H100 execution)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# RunPod on-demand GPU worker endpoints
RUNPOD_API_KEY=

# Security
# Generate a cryptographically secure random 32+ character string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-secure-random-32-char-secret-key-in-production

# ── Additional variables read by the app (added 2026-10-28 docs pass) ──────
# Every entry below is a placeholder example only — never a real secret.
# Aliases are noted where the code reads more than one name for one thing;
# set the canonical one unless a specific module needs its alias.

# Additional provider keys (optional; set only providers you use)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
GROP_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
# Aliases of keys above: GEMINI_API_KEY / GOOGLE_GEMINI_API_KEY (= GOOGLE_API_KEY)
GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FEATHERLESS_MODEL=
FIREWORKS_MODEL=
# Alias of HF_TOKEN
HUGGINGFACE_HUB_TOKEN=
# Alias of BRAVE_SEARCH_API_KEY
BRAVE_API_KEY=

# App / API identity
API_KEY=
RASOSYNTH_API_KEY=
RASOSYNTH_BASE_URL=http://localhost:8000
# Canonical environment variable: development | staging | production | gpu_cluster
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_DISABLED=false
ADMIN_USER=
ADMIN_EMAIL=
USER_USER=
USER_EMAIL=
DEMO_MODE=false
# Deprecated alias of ENVIRONMENT (kept for backwards-compatibility; logs warning if set)
# AI_DATASET_ENVIRONMENT=

# Auth / security
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CSRF_SECRET=
CSRF_TOKEN_TTL_SECONDS=3600
ENCRYPTION_KEY=
# Secret used to HMAC-sign storage download URLs (set a random 32+ character
# value; never commit a real one). Required for delivery signed URLs.
SIGNED_URL_SECRET=
AUTO_GENERATE_JWT_SECRET=false

# Workers / serving infrastructure
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RAY_ADDRESS=
VLLM_BASE_URL=http://localhost:8000/v1
PERSISTENT_STORAGE_PATH=./data
AGENT_MEMORY_DIR=./data/agent_memory

# External data sources
# Aliases of AIKOSH_API_KEY
AIKOSH_ACCESS_KEY=
AI_KOSH_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_DEFAULT_REGION=
AZURE_KEY_VAULT_URI=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT_POINT=
SLACK_BACKUP_WEBHOOK_URL=

# Tracing / observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Intent extraction / resource limits (optional tuning)
INTENT_CACHE_TTL=3600
INTENT_FALLBACK_ON_ERROR=true
INTENT_MAX_ANTI_DOMAINS=10
INTENT_MAX_QUERY_LEN=500
INTENT_MIN_CONFIDENCE=0.5
MAX_CONCURRENT_OPERATIONS=10
MAX_DEPTH=5
MAX_FILE_SIZE=10485760
MAX_ITEMS=1000
MAX_MEMORY_MB=1024
MAX_REQUEST_BODY_SIZE=10485760
MAX_TIMEOUT_SECONDS=300

# ── Platform-provided (do NOT set by hand) ────────────────────────────────
# These are injected by the hosting platform / VCS and are listed here
# only so every variable the code reads is accounted for.
# GIT_COMMIT_SHA= (injected by git / CI)
# VERCEL=1 (injected by Vercel)
# VERCEL_GIT_COMMIT_SHA= (injected by Vercel)
# KUBERNETES_SERVICE_HOST= (injected by Kubernetes)
# HF_SPACE= (injected by Hugging Face Spaces)
# SPACE_HOST= (injected by Hugging Face Spaces)
# SPACE_ID= (injected by Hugging Face Spaces)
# RENDER= (injected by Render)


# Google Cloud service-account credentials file (path, not a key value)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Docker Compose defaults (only used when unset; these match the fallbacks
# in docker-compose.yml)
REDIS_PORT=6380
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8000
