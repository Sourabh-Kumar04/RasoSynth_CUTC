# =============================================================================
# ENVIRONMENT SECRETS & KEYS
# =============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt
*.p12
*.pfx
# HuggingFace token cache
.huggingface/

# =============================================================================
# DATABASE & DATA STORAGE
# =============================================================================
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3
# SQLite write-ahead log / shared memory sidecars
*.db-wal
*.db-shm

# =============================================================================
# GENERATED DATASETS & OUTPUT ARTIFACTS
# =============================================================================
outputs/*
!outputs/.gitkeep
scratch/
temp/
tmp/

# Fine-tuning model weights and checkpoints (can be tens of GB)
outputs/finetune/
*.safetensors
*.bin
*.pt
*.ckpt
# PEFT adapter files saved locally
adapter_model.safetensors
adapter_model.bin
adapter_config.json

# =============================================================================
# PYTHON & TESTING
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/
# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
.eggs/
# Type checking caches
.pytype/
.dmypy.json
dmypy.json

# =============================================================================
# FRONTEND & NODE.JS
# =============================================================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.turbo/
# TypeScript incremental build info (regenerated on every build)
frontend/tsconfig.tsbuildinfo
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# IDE & EDITOR FILES
# =============================================================================
.claude/
.vscode/
.idea/
*.swp
*.swo
*~
.direnv/

# =============================================================================
# OS FILES
# =============================================================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# =============================================================================
# DOCKER & INFRASTRUCTURE
# =============================================================================
